<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultation Slip - <%= c.reference_no %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background-color: #f1f5f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #1e293b; }
    .slip-container {
      max-width: 780px;
      margin: 30px auto;
      background: #ffffff;
      padding: 45px 50px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    .slip-header { border-bottom: 2px solid #0f172a; padding-bottom: 15px; margin-bottom: 25px; }
    .signature-box { margin-top: 50px; border-top: 1px solid #0f172a; text-align: center; padding-top: 6px; }
    @media print {
      body { background: #ffffff; margin: 0; padding: 0; }
      .slip-container { border: none; box-shadow: none; margin: 0; max-width: 100%; padding: 20px; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body>
  <div class="container no-print mt-3 text-center">
    <button onclick="window.print()" class="btn btn-primary fw-semibold px-4 shadow-sm me-2">
      <i class="bi bi-printer-fill me-1"></i> Print / Save as PDF
    </button>
    <a href="/consultations" class="btn btn-outline-secondary px-3">
      <i class="bi bi-arrow-left me-1"></i> Back to Ledger
    </a>
  </div>

  <div class="slip-container">
    <div class="slip-header text-center position-relative">
      <div class="small text-uppercase fw-bold text-secondary mb-1">Camarines Sur Polytechnic Colleges</div>
      <h4 class="fw-bold text-dark mb-1">OFFICIAL FACULTY CONSULTATION SLIP</h4>
      <div class="small text-muted">Academic Affairs &bull; Department of Information Technology</div>
      <div class="position-absolute top-0 end-0 small font-monospace text-secondary no-print">
        <%= new Date().toLocaleDateString() %>
      </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 bg-light p-3 rounded border">
      <div>
        <div class="small text-muted">REFERENCE NUMBER</div>
        <div class="fw-bold font-monospace text-primary fs-5"><%= c.reference_no %></div>
      </div>
      <div class="text-end">
        <div class="small text-muted">STATUS</div>
        <span class="badge bg-dark text-uppercase px-3 py-2"><%= c.status %></span>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-6">
        <div class="p-3 border rounded h-100 bg-white">
          <h6 class="fw-bold text-secondary text-uppercase small mb-2 border-bottom pb-1">Student Details</h6>
          <div><strong>Name:</strong> <%= c.student_name %></div>
          <div><strong>Student ID:</strong> <%= c.student_id_no %></div>
          <div><strong>Program:</strong> <%= c.student_dept || 'BS Information Technology' %></div>
          <div><strong>Email:</strong> <%= c.student_email %></div>
        </div>
      </div>
      <div class="col-6">
        <div class="p-3 border rounded h-100 bg-white">
          <h6 class="fw-bold text-secondary text-uppercase small mb-2 border-bottom pb-1">Faculty Details</h6>
          <div><strong>Instructor:</strong> <%= c.faculty_name %></div>
          <div><strong>Office:</strong> <%= c.office_location || 'CCS Faculty Office' %></div>
          <div><strong>Department:</strong> <%= c.faculty_dept || 'College of Computer Studies' %></div>
          <div><strong>Mode:</strong> <%= c.consultation_mode || 'In-Person' %></div>
        </div>
      </div>
    </div>

    <div class="p-3 border rounded mb-4 bg-white">
      <h6 class="fw-bold text-secondary text-uppercase small mb-2 border-bottom pb-1">Consultation Particulars</h6>
      <div class="row mb-2">
        <div class="col-6"><strong>Scheduled Date:</strong> <%= new Date(c.consultation_date).toLocaleDateString() %></div>
        <div class="col-6"><strong>Time Slot:</strong> <%= c.time_slot %></div>
      </div>
      <div class="mb-2"><strong>Subject / Course Code:</strong> <%= c.subject_code || 'N/A' %></div>
      <div class="mb-2"><strong>Topic / Agenda:</strong></div>
      <p class="small bg-light p-2 rounded border mb-0 text-dark" style="white-space: pre-wrap;"><%= c.topic_agenda %></p>
    </div>

    <% if (c.faculty_notes) { %>
      <div class="p-3 border rounded mb-4 bg-light">
        <h6 class="fw-bold text-secondary text-uppercase small mb-1">Faculty Consultation Notes / Recommendations</h6>
        <p class="small mb-0 text-dark"><%= c.faculty_notes %></p>
      </div>
    <% } %>

    <div class="row mt-5 pt-3">
      <div class="col-6">
        <div class="signature-box mx-4">
          <div class="fw-semibold text-dark"><%= c.student_name %></div>
          <div class="small text-muted">Student Signature over Printed Name</div>
        </div>
      </div>
      <div class="col-6">
        <div class="signature-box mx-4">
          <div class="fw-semibold text-dark"><%= c.faculty_name %></div>
          <div class="small text-muted">Faculty Signature / Verification</div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
