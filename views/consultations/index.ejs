<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultations Ledger - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar', { active: 'appointments' }) %>

  <div class="container my-4" style="max-width: 1280px;">
    <!-- Hero Banner -->
    <div class="hero-banner-soft">
      <div class="small text-uppercase fw-semibold tracking-wide text-light opacity-75 mb-1"><%= greeting %>,</div>
      <h2 class="fw-bold mb-1 text-uppercase"><%= user.full_name %></h2>
      <div class="small opacity-90"><i class="bi bi-calendar3 me-1"></i> <%= todayFormatted %></div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
      <div>
        <h4 class="fw-bold text-dark mb-1">Consultation Records Ledger</h4>
        <p class="text-muted small mb-0">Track scheduled appointments, reviews, and attendance verification.</p>
      </div>
      <div>
        <% if (user.role === 'student') { %>
          <a href="/faculty" class="btn btn-primary-pill btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule New Consultation
          </a>
        <% } %>
      </div>
    </div>

    <!-- Table Card with Zero Horizontal Overflow -->
    <div class="soft-card p-4">
      <div class="table-responsive" style="overflow-x: hidden !important;">
        <table class="table table-hover align-middle mb-0 w-100" style="table-layout: auto;">
          <thead class="small text-muted" style="border-bottom: 2px solid #edf2f7;">
            <tr>
              <th class="ps-2">REFERENCE NO.</th>
              <th><%= user.role === 'student' ? 'FACULTY MEMBER' : 'STUDENT REQUESTER' %></th>
              <th>DATE & TIME</th>
              <th>COURSE</th>
              <th>AGENDA</th>
              <th>STATUS</th>
              <th class="text-end pe-2">ACTIONS / OPTIONS</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-folder2-open fs-1 d-block mb-2 text-secondary"></i>
                  No consultation records found.
                </td>
              </tr>
            <% } %>

            <% records.forEach(function(r) { %>
              <tr>
                <td class="ps-2"><span class="ref-code-stamp"><%= r.reference_no %></span></td>
                <td>
                  <div class="fw-bold text-dark"><%= user.role === 'student' ? r.faculty_name : r.student_name %></div>
                  <div class="small text-muted" style="font-size: 0.76rem;"><%= user.role === 'student' ? (r.office_location || 'Faculty Room') : r.student_id_no %></div>
                </td>
                <td>
                  <div class="small fw-semibold text-dark"><%= new Date(r.consultation_date).toLocaleDateString() %></div>
                  <div class="small text-muted" style="font-size: 0.76rem;"><%= r.time_slot %></div>
                </td>
                <td><span class="badge rounded-pill px-3 py-1" style="background: #415993; color: white;"><%= r.subject_code || 'General' %></span></td>
                <td style="max-width: 170px;"><div class="small text-truncate" title="<%= r.topic_agenda %>"><%= r.topic_agenda %></div></td>
                <td>
                  <% if (r.status === 'confirmed') { %>
                    <span class="badge rounded-pill px-3 py-1 text-success bg-success-subtle">Confirmed</span>
                  <% } else if (r.status === 'completed') { %>
                    <span class="badge rounded-pill px-3 py-1 text-primary bg-primary-subtle">Completed</span>
                  <% } else if (r.status === 'cancelled' || r.status === 'rejected') { %>
                    <span class="badge rounded-pill px-3 py-1 text-danger bg-danger-subtle"><%= r.status.toUpperCase() %></span>
                  <% } else { %>
                    <span class="badge rounded-pill px-3 py-1 text-secondary bg-light border">Pending</span>
                  <% } %>
                </td>
                <td class="text-end pe-2">
                  <div class="d-inline-flex gap-2 align-items-center justify-content-end">
                    <a href="/consultations/slip/<%= r.reference_no %>" class="btn btn-icon-circle" target="_blank" title="Print Slip">
                      <i class="bi bi-printer"></i>
                    </a>

                    <% if (r.status === 'completed') { %>
                      <% if (user.role === 'student') { %>
                        <% if (!r.review_id) { %>
                          <button class="btn btn-warning btn-sm rounded-pill px-3 py-1" 
                                  data-bs-toggle="modal" 
                                  data-bs-target="#reviewModal"
                                  data-id="<%= r.id %>"
                                  data-faculty-id="<%= r.faculty_id %>"
                                  data-faculty-name="<%= r.faculty_name %>"
                                  data-ref="<%= r.reference_no %>">
                            <i class="bi bi-star-fill me-1"></i> Rate
                          </button>
                        <% } else { %>
                          <span class="badge bg-warning-subtle text-dark border px-2 py-1 small" title="Your Review: <%= r.review_comment || 'No comment' %>">
                            <i class="bi bi-star-fill text-warning me-1"></i><%= r.review_rating %>/5
                          </span>
                        <% } %>
                      <% } else if (user.role === 'faculty') { %>
                        <% if (r.review_rating) { %>
                          <span class="badge bg-warning-subtle text-dark border px-2 py-1 small" title="Student Feedback: <%= r.review_comment || 'No written feedback' %>">
                            <i class="bi bi-star-fill text-warning me-1"></i><%= r.review_rating %>/5
                          </span>
                        <% } else { %>
                          <span class="badge bg-light text-muted border px-2 py-1 small">Awaiting Rating</span>
                        <% } %>
                      <% } %>
                    <% } %>

                    <!-- Delete Button -->
                    <button type="button" class="btn btn-icon-circle btn-icon-delete" 
                            data-bs-toggle="modal" 
                            data-bs-target="#deleteConfirmModal"
                            data-id="<%= r.id %>"
                            data-ref="<%= r.reference_no %>"
                            data-target-name="<%= user.role === 'student' ? r.faculty_name : r.student_name %>"
                            title="Delete Consultation">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Delete Modal -->
  <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content dark-modal-content p-3">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-white"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirm Record Deletion</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form action="/consultations/delete" method="POST">
          <div class="modal-body py-4 text-center">
            <input type="hidden" name="consultation_id" id="deleteModalConsultationId">
            <div class="rounded-circle d-inline-flex p-3 mb-3" style="background: rgba(255, 255, 255, 0.08); color: #f87171;">
              <i class="bi bi-trash3 fs-2"></i>
            </div>
            <h5 class="fw-bold text-white mb-2">Are you sure you want to delete this consultation?</h5>
            <p class="text-light opacity-75 small mb-1">Reference: <strong id="deleteModalRef" class="text-info font-monospace"></strong></p>
            <p class="text-light opacity-75 small mb-3">With: <span id="deleteModalTargetName" class="text-white fw-semibold"></span></p>
          </div>
          <div class="modal-footer border-0 justify-content-center gap-2 pt-0">
            <button type="button" class="btn btn-secondary btn-sm px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary-pill btn-sm px-4">Yes, Delete Permanently</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Review Modal -->
  <div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content soft-card p-4">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-dark"><i class="bi bi-star-fill text-warning me-2"></i>Evaluate Consultation Session</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="/consultations/review" method="POST">
          <div class="modal-body py-3">
            <input type="hidden" name="consultation_id" id="modalReviewConsultationId">
            <input type="hidden" name="faculty_id" id="modalReviewFacultyId">

            <div class="alert alert-light border mb-3 py-2 small">
              Instructor: <strong id="modalReviewFacultyName"></strong><br>
              Reference: <span id="modalReviewRef" class="font-monospace text-primary"></span>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Consultation Rating *</label>
              <select name="rating" class="form-select sunken-input" required>
                <option value="5">5 Stars - Excellent</option>
                <option value="4">4 Stars - Very Good</option>
                <option value="3">3 Stars - Satisfactory</option>
                <option value="2">2 Stars - Needs Improvement</option>
                <option value="1">1 Star - Unsatisfactory</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Feedback & Comments (Optional)</label>
              <textarea name="comment" class="form-control sunken-input" rows="3" placeholder="Share your feedback..."></textarea>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold">Submit Evaluation</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const deleteModal = document.getElementById('deleteConfirmModal');
    if (deleteModal) {
      deleteModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('deleteModalConsultationId').value = btn.getAttribute('data-id');
        document.getElementById('deleteModalRef').textContent = btn.getAttribute('data-ref');
        document.getElementById('deleteModalTargetName').textContent = btn.getAttribute('data-target-name');
      });
    }

    const reviewModal = document.getElementById('reviewModal');
    if (reviewModal) {
      reviewModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('modalReviewConsultationId').value = btn.getAttribute('data-id');
        document.getElementById('modalReviewFacultyId').value = btn.getAttribute('data-faculty-id');
        document.getElementById('modalReviewFacultyName').textContent = btn.getAttribute('data-faculty-name');
        document.getElementById('modalReviewRef').textContent = btn.getAttribute('data-ref');
      });
    }
  </script>
</body>
</html>
