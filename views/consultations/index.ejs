<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultations Ledger - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    html { overflow-y: scroll; }
    body { background-color: #f1f5f9; font-family: system-ui, -apple-system, sans-serif; }
    .hero-banner {
      background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%);
      border-radius: 16px;
      color: white;
      padding: 30px 35px;
      margin-bottom: 25px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(2, 132, 199, 0.2);
    }
    .hero-banner::after {
      content: "";
      position: absolute;
      right: -20px;
      bottom: -40px;
      width: 220px;
      height: 220px;
      background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 70%);
      border-radius: 50%;
    }
    .badge-status-pending { background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
    .badge-status-confirmed { background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; }
    .badge-status-completed { background-color: #cff4fc; color: #055160; border: 1px solid #b6effb; }
    .badge-status-cancelled, .badge-status-rejected { background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; }
    .role-badge { font-size: 0.68rem; letter-spacing: 0.8px; font-weight: 800; padding: 4px 8px; border-radius: 6px; }
    .dropdown-menu-notif { width: 320px; max-height: 400px; overflow-y: auto; border-radius: 12px; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/dashboard">
        <i class="bi bi-calendar2-check-fill me-2 fs-5"></i> Faculty Consultation Portal
      </a>
      <div class="d-flex align-items-center gap-2">
        <a href="/dashboard" class="btn btn-outline-light btn-sm"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
        <a href="/faculty" class="btn btn-outline-light btn-sm"><i class="bi bi-search me-1"></i> Directory</a>
        <a href="/timetable" class="btn btn-outline-light btn-sm"><i class="bi bi-grid-3x3-gap me-1"></i> Schedule</a>
        <a href="/consultations" class="btn btn-light btn-sm text-primary fw-semibold"><i class="bi bi-journal-text me-1"></i> Appointments</a>
        
        <div class="dropdown">
          <button class="btn btn-outline-light btn-sm position-relative" type="button" id="notifBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
            <i class="bi bi-bell-fill"></i>
            <% if (unreadNotifCount > 0) { %>
              <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                <%= unreadNotifCount %>
              </span>
            <% } %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm dropdown-menu-notif p-0" aria-labelledby="notifBellBtn">
            <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
              <span class="fw-bold small text-dark"><i class="bi bi-bell me-1"></i> Notifications</span>
              <span class="badge bg-primary rounded-pill"><%= notificationsList.length %></span>
            </li>
            <% if (notificationsList.length === 0) { %>
              <li class="p-4 text-center text-muted small">
                <i class="bi bi-bell-slash fs-4 d-block mb-1"></i>
                No notifications yet.
              </li>
            <% } %>
            <% notificationsList.forEach(function(n) { %>
              <li>
                <a href="<%= n.link || '/consultations' %>" class="dropdown-item p-3 border-bottom <%= n.is_read ? 'text-muted' : 'bg-light-subtle fw-semibold' %>" style="white-space: normal;">
                  <div class="d-flex justify-content-between align-items-start">
                    <span class="small <%= n.is_read ? 'text-dark' : 'text-primary' %>"><%= n.title %></span>
                    <span class="text-muted" style="font-size: 0.65rem;"><%= new Date(n.created_at).toLocaleDateString([], {month:'short', day:'numeric'}) %></span>
                  </div>
                  <div class="small text-secondary mt-1" style="font-size: 0.78rem;"><%= n.message %></div>
                </a>
              </li>
            <% }); %>
          </ul>
        </div>

        <div class="vr bg-white mx-2" style="height: 22px; opacity: 0.35;"></div>
        
        <div class="d-flex align-items-center bg-white bg-opacity-10 border border-white border-opacity-25 rounded-pill px-3 py-1 me-1">
          <i class="bi bi-person-circle text-white me-2 fs-6"></i>
          <span class="text-white fw-semibold small me-2"><%= user.full_name %></span>
          <span class="badge <%= user.role === 'faculty' ? 'bg-warning text-dark' : 'bg-white text-primary' %> text-uppercase role-badge">
            <%= user.role %>
          </span>
        </div>

        <a href="/logout" class="btn btn-outline-light btn-sm" title="Logout"><i class="bi bi-box-arrow-right"></i></a>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <div class="hero-banner">
      <div class="small text-uppercase fw-semibold tracking-wide text-light opacity-75 mb-1">
        <%= greeting %>,
      </div>
      <h2 class="fw-bold mb-1 text-uppercase"><%= user.full_name %></h2>
      <div class="small opacity-90"><i class="bi bi-calendar3 me-1"></i> <%= todayFormatted %></div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h4 class="fw-bold text-dark mb-1">Consultation Records Ledger</h4>
        <p class="text-muted small mb-0">Track scheduled appointments, review feedback, and generate official consultation slips.</p>
      </div>
      <div>
        <% if (user.role === 'student') { %>
          <a href="/faculty" class="btn btn-primary btn-sm fw-semibold">
            <i class="bi bi-calendar-plus me-1"></i> Schedule New Consultation
          </a>
        <% } %>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small text-secondary">
            <tr>
              <th class="ps-4">Reference No.</th>
              <th><%= user.role === 'student' ? 'Faculty Member' : 'Student Requester' %></th>
              <th>Date & Time</th>
              <th>Course / Subject</th>
              <th>Topic / Agenda</th>
              <th>Status</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-folder2-open fs-1 d-block mb-2 text-secondary"></i>
                  No consultation records found.
                </td>
              </tr>
            <% } %>

            <% records.forEach(function(r) { %>
              <tr>
                <td class="ps-4">
                  <span class="fw-bold text-primary font-monospace"><%= r.reference_no %></span>
                </td>
                <td>
                  <div class="fw-semibold text-dark"><%= user.role === 'student' ? r.faculty_name : r.student_name %></div>
                  <div class="small text-muted"><%= user.role === 'student' ? (r.office_location || 'Faculty Room') : r.student_id_no %></div>
                </td>
                <td>
                  <div class="small fw-semibold text-dark"><%= new Date(r.consultation_date).toLocaleDateString() %></div>
                  <div class="small text-muted"><%= r.time_slot %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= r.subject_code || 'General' %></span>
                </td>
                <td style="max-width: 220px;">
                  <div class="small text-truncate" title="<%= r.topic_agenda %>"><%= r.topic_agenda %></div>
                </td>
                <td>
                  <span class="badge badge-status-<%= r.status %> text-capitalize px-2 py-1">
                    <%= r.status %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-1 align-items-center">
                    <a href="/consultations/slip/<%= r.reference_no %>" class="btn btn-outline-secondary btn-sm" target="_blank" title="Print Slip">
                      <i class="bi bi-printer"></i>
                    </a>

                    <% if (user.role === 'student' && r.status === 'completed') { %>
                      <% if (!r.review_id) { %>
                        <button class="btn btn-warning btn-sm fw-semibold" 
                                data-bs-toggle="modal" 
                                data-bs-target="#reviewModal"
                                data-id="<%= r.id %>"
                                data-faculty-id="<%= r.faculty_id %>"
                                data-faculty-name="<%= r.faculty_name %>"
                                data-ref="<%= r.reference_no %>">
                          <i class="bi bi-star-fill me-1"></i> Rate
                        </button>
                      <% } else { %>
                        <span class="badge bg-warning-subtle text-dark border px-2 py-1 small" title="<%= r.review_comment %>">
                          <i class="bi bi-star-fill text-warning me-1"></i><%= r.review_rating %>/5
                        </span>
                      <% } %>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-warning-subtle text-dark">
          <h5 class="modal-title fw-bold"><i class="bi bi-star-fill text-warning me-2"></i>Evaluate Consultation Session</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="/consultations/review" method="POST">
          <div class="modal-body p-4">
            <input type="hidden" name="consultation_id" id="modalReviewConsultationId">
            <input type="hidden" name="faculty_id" id="modalReviewFacultyId">

            <div class="alert alert-light border mb-3 py-2 small">
              Instructor: <strong id="modalReviewFacultyName"></strong><br>
              Reference: <span id="modalReviewRef" class="font-monospace text-primary"></span>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Consultation Rating <span class="text-danger">*</span></label>
              <select name="rating" class="form-select" required>
                <option value="5">5 Stars - Excellent (Highly Helpful & Clear)</option>
                <option value="4">4 Stars - Very Good (Informative)</option>
                <option value="3">3 Stars - Satisfactory</option>
                <option value="2">2 Stars - Needs Improvement</option>
                <option value="1">1 Star - Unsatisfactory</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Feedback & Comments (Optional)</label>
              <textarea name="comment" class="form-control" rows="3" placeholder="Share what went well or how the consultation helped your learning..."></textarea>
            </div>
          </div>
          <div class="modal-footer bg-light border-0">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning btn-sm fw-semibold">Submit Evaluation</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const reviewModal = document.getElementById('reviewModal');
    if (reviewModal) {
      reviewModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('modalReviewConsultationId').value = btn.getAttribute('data-id');
        document.getElementById('modalReviewFacultyId').value = btn.getAttribute('data-faculty-id');
        document.getElementById('modalReviewFacultyName').textContent = btn.getAttribute('data-faculty-name');
        document.getElementById('modalReviewRef').textContent = btn.getAttribute('data-ref');
      });
    }

    const notifBtn = document.getElementById('notifBellBtn');
    const notifBadge = document.getElementById('notifBadge');
    if (notifBtn) {
      notifBtn.addEventListener('click', () => {
        if (notifBadge) {
          fetch('/notifications/mark-read', { method: 'POST' })
            .then(() => { notifBadge.style.display = 'none'; })
            .catch(err => console.error(err));
        }
      });
    }
  </script>
</body>
</html>
