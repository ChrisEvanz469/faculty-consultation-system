<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultations Ledger - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    html { overflow-y: scroll; }
    body { background-color: #f1f5f9; font-family: system-ui, -apple-system, sans-serif; }
    .hero-banner {
      background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%);
      border-radius: 16px; color: white; padding: 30px 35px; margin-bottom: 25px; position: relative; overflow: hidden;
    }
    .badge-status-pending { background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
    .badge-status-confirmed { background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; }
    .badge-status-completed { background-color: #cff4fc; color: #055160; border: 1px solid #b6effb; }
    .badge-status-cancelled, .badge-status-rejected { background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; }
  </style>
</head>
<body>
  <%- include('../partials/navbar', { active: 'appointments' }) %>

  <div class="container my-4">
    <div class="hero-banner">
      <div class="small text-uppercase fw-semibold tracking-wide text-light opacity-75 mb-1"><%= greeting %>,</div>
      <h2 class="fw-bold mb-1 text-uppercase"><%= user.full_name %></h2>
      <div class="small opacity-90"><i class="bi bi-calendar3 me-1"></i> <%= todayFormatted %></div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h4 class="fw-bold text-dark mb-1">Consultation Records Ledger</h4>
        <p class="text-muted small mb-0">Track scheduled appointments, reviews, and attendance verification.</p>
      </div>
      <div>
        <% if (user.role === 'student') { %>
          <a href="/faculty" class="btn btn-primary btn-sm fw-semibold">
            <i class="bi bi-calendar-plus me-1"></i> Schedule New Consultation
          </a>
        <% } %>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small text-secondary">
            <tr>
              <th class="ps-4">Reference No.</th>
              <th><%= user.role === 'student' ? 'Faculty Member' : 'Student Requester' %></th>
              <th>Date & Time</th>
              <th>Course</th>
              <th>Agenda</th>
              <th>Status</th>
              <th class="text-end pe-4">Actions / Options</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-folder2-open fs-1 d-block mb-2 text-secondary"></i>
                  No consultation records found.
                </td>
              </tr>
            <% } %>

            <% records.forEach(function(r) { %>
              <tr>
                <td class="ps-4">
                  <span class="fw-bold text-primary font-monospace"><%= r.reference_no %></span>
                </td>
                <td>
                  <div class="fw-semibold text-dark"><%= user.role === 'student' ? r.faculty_name : r.student_name %></div>
                  <div class="small text-muted"><%= user.role === 'student' ? (r.office_location || 'Faculty Room') : r.student_id_no %></div>
                </td>
                <td>
                  <div class="small fw-semibold text-dark"><%= new Date(r.consultation_date).toLocaleDateString() %></div>
                  <div class="small text-muted"><%= r.time_slot %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= r.subject_code || 'General' %></span>
                </td>
                <td style="max-width: 200px;">
                  <div class="small text-truncate" title="<%= r.topic_agenda %>"><%= r.topic_agenda %></div>
                </td>
                <td>
                  <span class="badge badge-status-<%= r.status %> text-capitalize px-2 py-1"><%= r.status %></span>
                </td>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-1 align-items-center justify-content-end">
                    <a href="/consultations/slip/<%= r.reference_no %>" class="btn btn-outline-secondary btn-sm" target="_blank" title="Print Slip">
                      <i class="bi bi-printer"></i>
                    </a>

                    <!-- Star Ratings Display -->
                    <% if (r.status === 'completed') { %>
                      <% if (user.role === 'student') { %>
                        <% if (!r.review_id) { %>
                          <button class="btn btn-warning btn-sm fw-semibold" 
                                  data-bs-toggle="modal" 
                                  data-bs-target="#reviewModal"
                                  data-id="<%= r.id %>"
                                  data-faculty-id="<%= r.faculty_id %>"
                                  data-faculty-name="<%= r.faculty_name %>"
                                  data-ref="<%= r.reference_no %>">
                            <i class="bi bi-star-fill me-1"></i> Rate
                          </button>
                        <% } else { %>
                          <span class="badge bg-warning-subtle text-dark border px-2 py-1 small" title="Your Review: <%= r.review_comment || 'No comment' %>">
                            <i class="bi bi-star-fill text-warning me-1"></i><%= r.review_rating %>/5
                          </span>
                        <% } %>
                      <% } else if (user.role === 'faculty') { %>
                        <% if (r.review_rating) { %>
                          <span class="badge bg-warning-subtle text-dark border px-2 py-1 small" title="Student Feedback: <%= r.review_comment || 'No written feedback' %>">
                            <i class="bi bi-star-fill text-warning me-1"></i><%= r.review_rating %>/5
                          </span>
                        <% } else { %>
                          <span class="badge bg-light text-muted border px-2 py-1 small">Awaiting Rating</span>
                        <% } %>
                      <% } %>
                    <% } %>

                    <!-- Delete / Cancel Button (Available for both Student and Instructor) -->
                    <button type="button" class="btn btn-outline-danger btn-sm" 
                            data-bs-toggle="modal" 
                            data-bs-target="#deleteConfirmModal"
                            data-id="<%= r.id %>"
                            data-ref="<%= r.reference_no %>"
                            data-target-name="<%= user.role === 'student' ? r.faculty_name : r.student_name %>"
                            title="Delete Consultation">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Record Deletion</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form action="/consultations/delete" method="POST">
          <div class="modal-body p-4 text-center">
            <input type="hidden" name="consultation_id" id="deleteModalConsultationId">
            <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex p-3 mb-3">
              <i class="bi bi-trash3-fill fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Are you sure you want to delete this consultation?</h5>
            <p class="text-muted small mb-1">
              Reference: <strong id="deleteModalRef" class="font-monospace text-primary"></strong>
            </p>
            <p class="text-muted small mb-3">
              With: <span id="deleteModalTargetName" class="fw-semibold text-dark"></span>
            </p>
            <div class="alert alert-warning py-2 small mb-0">
              <i class="bi bi-info-circle me-1"></i> Deleting will permanently remove this appointment and automatically reopen the time slot for other students.
            </div>
          </div>
          <div class="modal-footer bg-light border-0 justify-content-center">
            <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Cancel, Keep Record</button>
            <button type="submit" class="btn btn-danger btn-sm px-4 fw-semibold">Yes, Delete Permanently</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Review Modal -->
  <div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-warning-subtle text-dark">
          <h5 class="modal-title fw-bold"><i class="bi bi-star-fill text-warning me-2"></i>Evaluate Consultation Session</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="/consultations/review" method="POST">
          <div class="modal-body p-4">
            <input type="hidden" name="consultation_id" id="modalReviewConsultationId">
            <input type="hidden" name="faculty_id" id="modalReviewFacultyId">

            <div class="alert alert-light border mb-3 py-2 small">
              Instructor: <strong id="modalReviewFacultyName"></strong><br>
              Reference: <span id="modalReviewRef" class="font-monospace text-primary"></span>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Consultation Rating <span class="text-danger">*</span></label>
              <select name="rating" class="form-select" required>
                <option value="5">5 Stars - Excellent (Highly Helpful & Clear)</option>
                <option value="4">4 Stars - Very Good (Informative)</option>
                <option value="3">3 Stars - Satisfactory</option>
                <option value="2">2 Stars - Needs Improvement</option>
                <option value="1">1 Star - Unsatisfactory</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Feedback & Comments (Optional)</label>
              <textarea name="comment" class="form-control" rows="3" placeholder="Share what went well or how the consultation helped your learning..."></textarea>
            </div>
          </div>
          <div class="modal-footer bg-light border-0">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning btn-sm fw-semibold">Submit Evaluation</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Delete Confirmation Modal Event Listener
    const deleteModal = document.getElementById('deleteConfirmModal');
    if (deleteModal) {
      deleteModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('deleteModalConsultationId').value = btn.getAttribute('data-id');
        document.getElementById('deleteModalRef').textContent = btn.getAttribute('data-ref');
        document.getElementById('deleteModalTargetName').textContent = btn.getAttribute('data-target-name');
      });
    }

    // Review Modal Event Listener
    const reviewModal = document.getElementById('reviewModal');
    if (reviewModal) {
      reviewModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('modalReviewConsultationId').value = btn.getAttribute('data-id');
        document.getElementById('modalReviewFacultyId').value = btn.getAttribute('data-faculty-id');
        document.getElementById('modalReviewFacultyName').textContent = btn.getAttribute('data-faculty-name');
        document.getElementById('modalReviewRef').textContent = btn.getAttribute('data-ref');
      });
    }

    const notifBtn = document.getElementById('notifBellBtn');
    const notifBadge = document.getElementById('notifBadge');
    if (notifBtn) {
      notifBtn.addEventListener('click', () => {
        if (notifBadge) {
          fetch('/notifications/mark-read', { method: 'POST' })
            .then(() => { notifBadge.style.display = 'none'; })
            .catch(err => console.error(err));
        }
      });
    }
  </script>
</body>
</html>
