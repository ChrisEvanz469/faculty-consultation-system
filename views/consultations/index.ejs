<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consultations Ledger - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; }
    .badge-status-pending { background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
    .badge-status-confirmed { background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc; }
    .badge-status-completed { background-color: #cff4fc; color: #055160; border: 1px solid #b6effb; }
    .badge-status-cancelled { background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/faculty">
        <i class="bi bi-calendar2-check-fill me-2 fs-5"></i> Faculty Consultation Portal
      </a>
      <div class="d-flex align-items-center gap-3">
        <a href="/faculty" class="btn btn-outline-light btn-sm"><i class="bi bi-search me-1"></i> Faculty Directory</a>
        <a href="/consultations" class="btn btn-light btn-sm text-primary fw-semibold"><i class="bi bi-journal-text me-1"></i> My Appointments</a>
        <span class="text-white small ms-2"><i class="bi bi-person-circle me-1"></i> <%= user.full_name %></span>
        <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i></a>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h3 class="fw-bold text-dark mb-1">Consultation Records Ledger</h3>
        <p class="text-muted small mb-0">Track scheduled appointments, faculty review status, and attendance slips.</p>
      </div>
      <div>
        <a href="/faculty" class="btn btn-primary btn-sm fw-semibold">
          <i class="bi bi-calendar-plus me-1"></i> Schedule New Consultation
        </a>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light small text-secondary">
            <tr>
              <th class="ps-4">Reference No.</th>
              <th><%= user.role === 'student' ? 'Faculty Member' : 'Student Requester' %></th>
              <th>Date & Time</th>
              <th>Course / Subject</th>
              <th>Topic / Agenda</th>
              <th>Status</th>
              <th class="text-end pe-4">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-folder2-open fs-1 d-block mb-2 text-secondary"></i>
                  No consultation records found.
                </td>
              </tr>
            <% } %>

            <% records.forEach(function(r) { %>
              <tr>
                <td class="ps-4">
                  <span class="fw-bold text-primary font-monospace"><%= r.reference_no %></span>
                </td>
                <td>
                  <div class="fw-semibold text-dark"><%= user.role === 'student' ? r.faculty_name : r.student_name %></div>
                  <div class="small text-muted"><%= user.role === 'student' ? (r.office_location || 'Faculty Room') : r.student_id_no %></div>
                </td>
                <td>
                  <div class="small fw-semibold text-dark"><%= new Date(r.consultation_date).toLocaleDateString() %></div>
                  <div class="small text-muted"><%= r.time_slot %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= r.subject_code || 'General' %></span>
                </td>
                <td style="max-width: 240px;">
                  <div class="small text-truncate" title="<%= r.topic_agenda %>"><%= r.topic_agenda %></div>
                </td>
                <td>
                  <span class="badge badge-status-<%= r.status %> text-capitalize px-2 py-1">
                    <%= r.status %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <a href="/consultations/slip/<%= r.reference_no %>" class="btn btn-outline-secondary btn-sm" target="_blank" title="Print Slip">
                    <i class="bi bi-printer me-1"></i> Slip
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
