<div class="floating-navbar-container">
  <div class="floating-navbar d-flex flex-wrap justify-content-between align-items-center gap-3">
    
    <!-- Left Brand Pill -->
    <a href="/dashboard" class="nav-brand-pill d-flex align-items-center">
      <i class="bi bi-calendar2-check-fill me-2 fs-6"></i> Faculty Consultation Portal
    </a>

    <!-- Center Navigation Tabs -->
    <div class="d-flex align-items-center gap-2">
      <a href="/dashboard" class="nav-pill-btn <%= active === 'dashboard' ? 'active' : '' %>">
        <i class="bi bi-speedometer2 me-1"></i> Dashboard
      </a>

      <% if (user.role === 'student') { %>
        <a href="/faculty" class="nav-pill-btn <%= active === 'directory' ? 'active' : '' %>">
          <i class="bi bi-search me-1"></i> Directory
        </a>
        <a href="/timetable" class="nav-pill-btn <%= active === 'schedule' ? 'active' : '' %>">
          <i class="bi bi-grid-3x3-gap me-1"></i> Schedule
        </a>
      <% } else { %>
        <a href="/faculty/schedule" class="nav-pill-btn <%= active === 'schedule' ? 'active' : '' %>">
          <i class="bi bi-clock-history me-1"></i> Manage Schedule
        </a>
      <% } %>

      <a href="/consultations" class="nav-pill-btn <%= active === 'appointments' ? 'active' : '' %>">
        <i class="bi bi-journal-text me-1"></i> Appointments
      </a>
    </div>

    <!-- Right Controls -->
    <div class="d-flex align-items-center gap-2">
      <!-- Notification Bell -->
      <div class="dropdown">
        <button class="btn btn-icon-circle position-relative" type="button" id="notifBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
          <i class="bi bi-bell-fill"></i>
          <% if (unreadNotifCount > 0) { %>
            <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
              <%= unreadNotifCount %>
            </span>
          <% } %>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow p-0" style="width: 320px; max-height: 400px; overflow-y: auto; border-radius: 16px;" aria-labelledby="notifBellBtn">
          <li class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
            <span class="fw-bold small text-dark"><i class="bi bi-bell me-1"></i> Notifications</span>
            <span class="badge bg-primary rounded-pill"><%= notificationsList.length %></span>
          </li>
          <% if (notificationsList.length === 0) { %>
            <li class="p-4 text-center text-muted small">
              <i class="bi bi-bell-slash fs-4 d-block mb-1"></i>
              No notifications yet.
            </li>
          <% } %>
          <% notificationsList.forEach(function(n) { %>
            <li>
              <a href="<%= n.link || '/consultations' %>" class="dropdown-item p-3 border-bottom <%= n.is_read ? 'text-muted' : 'bg-light-subtle fw-semibold' %>" style="white-space: normal;">
                <div class="d-flex justify-content-between align-items-start">
                  <span class="small <%= n.is_read ? 'text-dark' : 'text-primary' %>"><%= n.title %></span>
                  <span class="text-muted" style="font-size: 0.65rem;"><%= new Date(n.created_at).toLocaleDateString([], {month:'short', day:'numeric'}) %></span>
                </div>
                <div class="small text-secondary mt-1" style="font-size: 0.78rem;"><%= n.message %></div>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>

      <!-- User Identity Capsule -->
      <div class="nav-user-capsule d-flex align-items-center gap-2">
        <i class="bi bi-person-circle fs-6 text-muted"></i>
        <span><%= user.full_name %></span>
        <span class="role-badge-tag"><%= user.role.toUpperCase() %></span>
      </div>

      <!-- Logout Button -->
      <a href="/logout" class="btn btn-icon-circle" title="Sign Out">
        <i class="bi bi-box-arrow-right"></i>
      </a>
    </div>

  </div>
</div>
