<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar', { active: 'dashboard' }) %>

  <div class="container my-4" style="max-width: 1280px;">
    <!-- Hero Banner -->
    <div class="hero-banner-soft">
      <div class="small text-uppercase fw-semibold tracking-wide text-light opacity-75 mb-1"><%= greeting %>,</div>
      <h2 class="fw-bold mb-1 text-uppercase"><%= user.full_name %></h2>
      <div class="small opacity-90"><i class="bi bi-calendar3 me-1"></i> <%= todayFormatted %></div>
    </div>

    <!-- Section Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
      <div>
        <h4 class="fw-bold text-dark mb-1">Consultation Dashboard</h4>
        <p class="text-muted small mb-0">Overview of academic consultation schedules, status metrics, and pending actions.</p>
      </div>
      <div>
        <% if (user.role === 'student') { %>
          <a href="/faculty" class="btn btn-primary-pill btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Book New Consultation
          </a>
        <% } else { %>
          <a href="/faculty/schedule" class="btn btn-primary-pill btn-sm">
            <i class="bi bi-clock-history me-1"></i> Configure Office Hours
          </a>
        <% } %>
      </div>
    </div>

    <!-- 4 KPI Metrics Cards -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3">
        <div class="soft-card p-4 d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold text-uppercase">Total Requests</div>
            <h2 class="fw-bold text-dark mb-0 mt-1"><%= metrics.total %></h2>
          </div>
          <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #e8eef8; color: #415993;">
            <i class="bi bi-folder2-open fs-4"></i>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="soft-card p-4 d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold text-uppercase">Pending Review</div>
            <h2 class="fw-bold text-dark mb-0 mt-1"><%= metrics.pending %></h2>
          </div>
          <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #fef3c7; color: #d97706;">
            <i class="bi bi-clock-history fs-4"></i>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="soft-card p-4 d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold text-uppercase">Confirmed</div>
            <h2 class="fw-bold text-dark mb-0 mt-1"><%= metrics.confirmed %></h2>
          </div>
          <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #dcfce7; color: #16a34a;">
            <i class="bi bi-check2-circle fs-4"></i>
          </div>
        </div>
      </div>

      <div class="col-sm-6 col-lg-3">
        <div class="soft-card p-4 d-flex justify-content-between align-items-center">
          <div>
            <div class="text-muted small fw-semibold text-uppercase">Completed</div>
            <h2 class="fw-bold text-dark mb-0 mt-1"><%= metrics.completed %></h2>
          </div>
          <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #e0f2fe; color: #0284c7;">
            <i class="bi bi-patch-check fs-4"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Records Table Card -->
    <div class="soft-card overflow-hidden p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-list-check me-2 text-primary"></i>Active Consultation Records</h6>
        <span class="badge rounded-pill bg-light text-muted border px-3 py-2"><%= records.length %> records</span>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="small text-muted" style="border-bottom: 2px solid #edf2f7;">
            <tr>
              <th class="ps-3">REFERENCE NO.</th>
              <th><%= user.role === 'student' ? 'FACULTY MEMBER' : 'STUDENT REQUESTER' %></th>
              <th>DATE & SLOT</th>
              <th>COURSE</th>
              <th>AGENDA</th>
              <th>STATUS</th>
              <th class="text-end pe-3">ACTIONS</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                  No consultations registered yet.
                </td>
              </tr>
            <% } %>

            <% records.forEach(function(r) { %>
              <tr>
                <td class="ps-3"><span class="fw-bold font-monospace" style="color: #415993;"><%= r.reference_no %></span></td>
                <td>
                  <div class="fw-bold text-dark"><%= user.role === 'student' ? r.faculty_name : r.student_name %></div>
                  <div class="small text-muted"><%= user.role === 'student' ? (r.office_location || 'Faculty Room') : r.student_id_no %></div>
                </td>
                <td>
                  <div class="small fw-semibold text-dark"><%= new Date(r.consultation_date).toLocaleDateString() %></div>
                  <div class="small text-muted"><%= r.time_slot %></div>
                </td>
                <td><span class="badge rounded-pill px-3 py-2" style="background: #415993; color: white;"><%= r.subject_code || 'General' %></span></td>
                <td style="max-width: 180px;"><div class="small text-truncate" title="<%= r.topic_agenda %>"><%= r.topic_agenda %></div></td>
                <td>
                  <% if (r.status === 'confirmed') { %>
                    <span class="badge rounded-pill px-3 py-2 text-success bg-success-subtle">Confirmed</span>
                  <% } else if (r.status === 'completed') { %>
                    <span class="badge rounded-pill px-3 py-2 text-primary bg-primary-subtle">Completed</span>
                  <% } else if (r.status === 'cancelled' || r.status === 'rejected') { %>
                    <span class="badge rounded-pill px-3 py-2 text-danger bg-danger-subtle"><%= r.status.toUpperCase() %></span>
                  <% } else { %>
                    <span class="badge rounded-pill px-3 py-2 text-secondary bg-light border">Pending</span>
                  <% } %>
                </td>
                <td class="text-end pe-3">
                  <div class="d-inline-flex gap-2 align-items-center">
                    <a href="/consultations/slip/<%= r.reference_no %>" class="btn btn-icon-circle" target="_blank" title="Print Slip">
                      <i class="bi bi-printer"></i>
                    </a>

                    <% if (user.role === 'faculty') { %>
                      <button class="btn btn-primary-pill btn-sm py-1 px-3" 
                              data-bs-toggle="modal" 
                              data-bs-target="#statusModal"
                              data-id="<%= r.id %>"
                              data-ref="<%= r.reference_no %>"
                              data-status="<%= r.status %>"
                              data-notes="<%= r.faculty_notes || '' %>"
                              title="Update Status">
                        <i class="bi bi-pencil-square me-1"></i> Action
                      </button>
                      <% if (r.status === 'completed' && r.review_rating) { %>
                        <span class="badge bg-warning-subtle text-dark border px-2 py-1 ms-1 d-inline-flex align-items-center" title="Student Review: <%= r.review_comment || 'No feedback' %>">
                          <i class="bi bi-star-fill text-warning me-1"></i><%= r.review_rating %>/5
                        </span>
                      <% } %>
                    <% } %>

                    <!-- Delete Button -->
                    <button type="button" class="btn btn-icon-circle btn-icon-delete" 
                            data-bs-toggle="modal" 
                            data-bs-target="#deleteConfirmModal"
                            data-id="<%= r.id %>"
                            data-ref="<%= r.reference_no %>"
                            data-target-name="<%= user.role === 'student' ? r.faculty_name : r.student_name %>"
                            title="Delete Consultation">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Neumorphic Dark Confirmation Modal for Deletion -->
  <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content dark-modal-content p-3">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold text-white"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirm Record Deletion</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form action="/consultations/delete" method="POST">
          <div class="modal-body py-4 text-center">
            <input type="hidden" name="consultation_id" id="deleteModalConsultationId">
            <div class="rounded-circle d-inline-flex p-3 mb-3" style="background: rgba(255, 255, 255, 0.08); color: #f87171;">
              <i class="bi bi-trash3 fs-2"></i>
            </div>
            <h5 class="fw-bold text-white mb-2">Are you sure you want to delete this consultation?</h5>
            <p class="text-light opacity-75 small mb-1">Reference: <strong id="deleteModalRef" class="text-info font-monospace"></strong></p>
            <p class="text-light opacity-75 small mb-3">With: <span id="deleteModalTargetName" class="text-white fw-semibold"></span></p>
          </div>
          <div class="modal-footer border-0 justify-content-center gap-2 pt-0">
            <button type="button" class="btn btn-secondary btn-sm px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary-pill btn-sm px-4">Yes, Delete Permanently</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Neumorphic Dark Modal for Faculty Status Action -->
  <% if (user.role === 'faculty') { %>
    <div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal-content p-3">
          <div class="modal-header border-0 pb-0">
            <h5 class="modal-title fw-bold text-white"><i class="bi bi-gear-fill text-primary me-2"></i>Update Consultation Status</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <form action="/consultations/status" method="POST">
            <div class="modal-body py-4">
              <input type="hidden" name="consultation_id" id="modalConsultationId">
              <div class="p-3 rounded-3 mb-3 small" style="background: rgba(255, 255, 255, 0.06);">
                Consultation Reference: <strong id="modalConsultationRef" class="text-info font-monospace"></strong>
              </div>

              <div class="mb-3">
                <label class="form-label small text-light opacity-75">Consultation Status *</label>
                <select name="status" id="modalStatusSelect" class="form-select dark-modal-input" required>
                  <option value="pending">Pending</option>
                  <option value="confirmed">Confirmed</option>
                  <option value="completed">Completed</option>
                  <option value="rejected">Rejected</option>
                  <option value="cancelled">Cancelled</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="form-label small text-light opacity-75">Faculty Instructions / Remarks</label>
                <textarea name="faculty_notes" id="modalFacultyNotes" class="form-control dark-modal-input" rows="3" placeholder="Provide consultation feedback..."></textarea>
              </div>
            </div>
            <div class="modal-footer border-0 justify-content-end gap-2 pt-0">
              <button type="button" class="btn btn-secondary btn-sm px-4 rounded-pill" data-bs-dismiss="modal">Close</button>
              <button type="submit" class="btn btn-primary-pill btn-sm px-4">Save Status Changes</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const deleteModal = document.getElementById('deleteConfirmModal');
    if (deleteModal) {
      deleteModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('deleteModalConsultationId').value = btn.getAttribute('data-id');
        document.getElementById('deleteModalRef').textContent = btn.getAttribute('data-ref');
        document.getElementById('deleteModalTargetName').textContent = btn.getAttribute('data-target-name');
      });
    }

    const statusModal = document.getElementById('statusModal');
    if (statusModal) {
      statusModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('modalConsultationId').value = btn.getAttribute('data-id');
        document.getElementById('modalConsultationRef').textContent = btn.getAttribute('data-ref');
        document.getElementById('modalStatusSelect').value = btn.getAttribute('data-status');
        document.getElementById('modalFacultyNotes').value = btn.getAttribute('data-notes') || '';
      });
    }
  </script>
</body>
</html>
