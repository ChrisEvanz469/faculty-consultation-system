<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Consultation Schedule - Faculty Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    html { overflow-y: scroll; }
    body { background-color: #f1f5f9; font-family: system-ui, -apple-system, sans-serif; }
    .hero-banner {
      background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%);
      border-radius: 16px;
      color: white;
      padding: 30px 35px;
      margin-bottom: 25px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 25px rgba(2, 132, 199, 0.2);
    }
    .hero-banner::after {
      content: "";
      position: absolute;
      right: -20px;
      bottom: -40px;
      width: 220px;
      height: 220px;
      background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0) 70%);
      border-radius: 50%;
    }
    .role-badge { font-size: 0.68rem; letter-spacing: 0.8px; font-weight: 800; padding: 4px 8px; border-radius: 6px; }
    .dropdown-menu-notif { width: 320px; max-height: 400px; overflow-y: auto; border-radius: 12px; }
  </style>
</head>
<body>
  <%- include('../partials/navbar', { active: 'schedule' }) %>

  <div class="container my-4">
    <div class="hero-banner">
      <div class="small text-uppercase fw-semibold tracking-wide text-light opacity-75 mb-1">
        <%= greeting %>,
      </div>
      <h2 class="fw-bold mb-1 text-uppercase"><%= user.full_name %></h2>
      <div class="small opacity-90"><i class="bi bi-calendar3 me-1"></i> <%= todayFormatted %></div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h4 class="fw-bold text-dark mb-1">Office Hours & Consultation Configuration</h4>
        <p class="text-muted small mb-0">Define your weekly availability windows, office cubicle, and consultation meeting link.</p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Left Column: Active Slots List -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check me-2 text-primary"></i>Active Consultation Windows</h5>
            <span class="badge bg-primary-subtle text-primary border px-3 py-2 rounded-pill">
              <%= (f.slots || []).length %> Active Slots
            </span>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light small text-secondary">
                <tr>
                  <th>Day of Week</th>
                  <th>Time Window</th>
                  <th>Capacity</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (!f.slots || f.slots.length === 0) { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-muted small">
                      <i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
                      No consultation slots configured. Add one below.
                    </td>
                  </tr>
                <% } else { %>
                  <% f.slots.forEach(s => { %>
                    <tr>
                      <td class="fw-bold text-dark"><%= s.day_of_week %></td>
                      <td>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                          <i class="bi bi-clock me-1"></i><%= s.start_time %> - <%= s.end_time %>
                        </span>
                      </td>
                      <td class="small text-muted"><%= s.max_students %> students max</td>
                      <td class="text-end">
                        <form action="/faculty/schedule/delete" method="POST" onsubmit="return confirm('Remove this consultation slot?');" class="d-inline">
                          <input type="hidden" name="slot_id" value="<%= s.id %>">
                          <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Delete Slot">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Add Slot Form -->
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
          <h5 class="fw-bold text-dark mb-3"><i class="bi bi-plus-circle me-2 text-success"></i>Add New Availability Slot</h5>
          <form action="/faculty/schedule/add" method="POST">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold">Day of Week <span class="text-danger">*</span></label>
                <select name="day_of_week" class="form-select" required>
                  <option value="Monday">Monday</option>
                  <option value="Tuesday">Tuesday</option>
                  <option value="Wednesday">Wednesday</option>
                  <option value="Thursday">Thursday</option>
                  <option value="Friday">Friday</option>
                  <option value="Saturday">Saturday</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold">Max Student Capacity</label>
                <input type="number" name="max_students" class="form-control" value="4" min="1" max="10" required>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold">Start Time <span class="text-danger">*</span></label>
                <input type="time" name="start_time" class="form-control" required>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold">End Time <span class="text-danger">*</span></label>
                <input type="time" name="end_time" class="form-control" required>
              </div>

              <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary fw-semibold px-4">
                  <i class="bi bi-plus-lg me-1"></i> Save Consultation Slot
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Right Column: Office Location & Meeting Mode -->
      <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
          <h5 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt me-2 text-primary"></i>Consultation Location & Settings</h5>
          
          <form action="/faculty/profile/update" method="POST">
            <div class="mb-3">
              <label class="form-label small fw-semibold">Office / Cubicle Location</label>
              <input type="text" name="office_location" class="form-control" value="<%= f.office_location || 'CCS Faculty Office' %>" placeholder="e.g. CCS Cubicle 4, 2nd Floor" required>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Primary Consultation Mode</label>
              <select name="consultation_mode" class="form-select">
                <option value="In-Person" <%= f.consultation_mode === 'In-Person' ? 'selected' : '' %>>In-Person Only</option>
                <option value="Hybrid" <%= f.consultation_mode === 'Hybrid' ? 'selected' : '' %>>Hybrid (In-Person & Online)</option>
                <option value="Online" <%= f.consultation_mode === 'Online' ? 'selected' : '' %>>Online Only</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Online Meeting Link (Google Meet / Zoom)</label>
              <input type="url" name="meeting_link" class="form-control" value="<%= f.meeting_link || '' %>" placeholder="https://meet.google.com/xxx-xxxx-xxx">
              <div class="form-text small">This link is shared automatically on student consultation slips.</div>
            </div>

            <button type="submit" class="btn btn-outline-primary fw-semibold w-100">
              <i class="bi bi-check-lg me-1"></i> Update Office Details
            </button>
          </form>
        </div>

        <!-- Instructor Overview Card -->
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-light border">
          <div class="small text-muted mb-1">Current Evaluation Rating</div>
          <div class="d-flex align-items-center gap-2">
            <span class="fs-4 fw-bold text-dark"><%= f.avg_rating || '5.0' %></span>
            <span class="text-warning fs-5"><i class="bi bi-star-fill"></i></span>
            <span class="text-muted small">(<%= f.review_count || 0 %> evaluations)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const notifBtn = document.getElementById('notifBellBtn');
    const notifBadge = document.getElementById('notifBadge');
    if (notifBtn) {
      notifBtn.addEventListener('click', () => {
        if (notifBadge) {
          fetch('/notifications/mark-read', { method: 'POST' })
            .then(() => { notifBadge.style.display = 'none'; })
            .catch(err => console.error(err));
        }
      });
    }
  </script>
</body>
</html>
