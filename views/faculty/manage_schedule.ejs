<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Consultation Schedule - Faculty Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar', { active: 'schedule' }) %>

  <div class="container my-4" style="max-width: 1280px;">
    <!-- Hero Banner -->
    <div class="hero-banner-soft">
      <div class="small text-uppercase fw-semibold tracking-wide text-light opacity-75 mb-1"><%= greeting %>,</div>
      <h2 class="fw-bold mb-1 text-uppercase"><%= user.full_name %></h2>
      <div class="small opacity-90"><i class="bi bi-calendar3 me-1"></i> <%= todayFormatted %></div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
      <div>
        <h4 class="fw-bold text-dark mb-1">Office Hours & Consultation Configuration</h4>
        <p class="text-muted small mb-0">Define your weekly availability windows, office cubicle, and consultation meeting link.</p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Left Column: Active Slots & Add Form -->
      <div class="col-lg-7">
        <div class="soft-card p-4 mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-check me-2 text-primary"></i>Active Consultation Windows</h6>
            <span class="badge rounded-pill text-white px-3 py-2" style="background: #415993;">
              <%= (f.slots || []).length %> Active Slots
            </span>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="small text-muted">
                <tr>
                  <th>DAY OF WEEK</th>
                  <th>TIME WINDOW</th>
                  <th>CAPACITY</th>
                  <th class="text-end pe-2">ACTION</th>
                </tr>
              </thead>
              <tbody>
                <% if (!f.slots || f.slots.length === 0) { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-muted small">
                      <i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
                      No consultation slots configured. Add one below.
                    </td>
                  </tr>
                <% } else { %>
                  <% f.slots.forEach(s => { %>
                    <tr>
                      <td class="fw-bold text-dark"><%= s.day_of_week %></td>
                      <td>
                        <span class="badge rounded-pill bg-light text-dark border px-3 py-2 small">
                          <i class="bi bi-clock me-1"></i><%= s.start_time %> - <%= s.end_time %>
                        </span>
                      </td>
                      <td class="small text-muted"><%= s.max_students %> students max</td>
                      <td class="text-end pe-2">
                        <form action="/faculty/schedule/delete" method="POST" onsubmit="return confirm('Remove this consultation slot?');" class="d-inline">
                          <input type="hidden" name="slot_id" value="<%= s.id %>">
                          <button type="submit" class="btn btn-icon-circle btn-icon-delete" title="Delete Slot">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Add Slot Form -->
        <div class="soft-card p-4">
          <h6 class="fw-bold text-dark mb-3"><i class="bi bi-plus-circle me-2 text-success"></i>Add New Availability Slot</h6>
          <form action="/faculty/schedule/add" method="POST">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Day of Week *</label>
                <select name="day_of_week" class="form-select sunken-input" required>
                  <option value="Monday">Monday</option>
                  <option value="Tuesday">Tuesday</option>
                  <option value="Wednesday">Wednesday</option>
                  <option value="Thursday">Thursday</option>
                  <option value="Friday">Friday</option>
                  <option value="Saturday">Saturday</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Max Student Capacity</label>
                <input type="number" name="max_students" class="form-control sunken-input" value="4" min="1" max="10" required>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Start Time *</label>
                <input type="time" name="start_time" class="form-control sunken-input" required>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">End Time *</label>
                <input type="time" name="end_time" class="form-control sunken-input" required>
              </div>

              <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary-pill">
                  <i class="bi bi-plus-lg me-1"></i> Save Consultation Slot
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Right Column: Location & Settings -->
      <div class="col-lg-5">
        <div class="soft-card p-4 mb-4">
          <h6 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt me-2 text-primary"></i>Consultation Location & Settings</h6>
          
          <form action="/faculty/profile/update" method="POST">
            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Office / Cubicle Location</label>
              <input type="text" name="office_location" class="form-control sunken-input" value="<%= f.office_location || 'CCS Faculty Office' %>" placeholder="e.g. CCS Cubicle 4" required>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Primary Consultation Mode</label>
              <select name="consultation_mode" class="form-select sunken-input">
                <option value="In-Person" <%= f.consultation_mode === 'In-Person' ? 'selected' : '' %>>In-Person Only</option>
                <option value="Hybrid" <%= f.consultation_mode === 'Hybrid' ? 'selected' : '' %>>Hybrid (In-Person & Online)</option>
                <option value="Online" <%= f.consultation_mode === 'Online' ? 'selected' : '' %>>Online Only</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-muted">Online Meeting Link (Google Meet / Zoom)</label>
              <input type="url" name="meeting_link" class="form-control sunken-input" value="<%= f.meeting_link || '' %>" placeholder="https://meet.google.com/xxx-xxxx-xxx">
              <div class="form-text small">This link is shared automatically on student consultation slips.</div>
            </div>

            <button type="submit" class="btn btn-primary-pill w-100">
              <i class="bi bi-check-lg me-1"></i> Update Office Details
            </button>
          </form>
        </div>

        <!-- Instructor Evaluation Rating Summary -->
        <div class="soft-card p-4">
          <div class="small text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.72rem;">Current Evaluation Rating</div>
          <div class="d-flex align-items-center gap-2">
            <span class="fs-2 fw-bold text-dark"><%= f.avg_rating || '5.0' %></span>
            <span class="text-warning fs-4"><i class="bi bi-star-fill"></i></span>
            <span class="text-muted small">(<%= f.review_count || 0 %> evaluations)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
