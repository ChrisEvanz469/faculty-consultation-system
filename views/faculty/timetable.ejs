<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Weekly Schedule - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar', { active: 'schedule' }) %>

  <div class="container-fluid px-4 my-4" style="max-width: 1400px;">
    <!-- Stationary Greeting Banner -->
    <div class="hero-banner-soft">
      <div class="small text-uppercase fw-semibold tracking-wide text-light opacity-75 mb-1"><%= greeting %>,</div>
      <h2 class="fw-bold mb-1 text-uppercase"><%= user.full_name %></h2>
      <div class="small opacity-90"><i class="bi bi-calendar3 me-1"></i> <%= todayFormatted %></div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
      <div>
        <h4 class="fw-bold text-dark mb-1">Weekly Consultation Timetable (Mon – Sat)</h4>
        <p class="text-muted small mb-0">Overview of faculty duty schedules, office cubicles, and consultation windows.</p>
      </div>
      <div>
        <a href="/faculty" class="btn btn-primary-pill btn-sm">
          <i class="bi bi-person-lines-fill me-1"></i> Directory View
        </a>
      </div>
    </div>

    <!-- 6 Columns: Monday to Saturday with Greeting Blue Column Headers -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-6 g-3">
      <% const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']; %>
      <% days.forEach(day => { %>
        <div class="col">
          <div class="soft-card p-3 h-100 d-flex flex-column">
            
            <div class="timetable-col-header">
              <span class="day-title"><%= day %></span>
              <span class="day-badge"><%= (matrix[day] || []).length %> slots</span>
            </div>

            <% if (!matrix[day] || matrix[day].length === 0) { %>
              <div class="flex-grow-1 d-flex align-items-center justify-content-center text-muted small py-4">
                No office hours
              </div>
            <% } else { %>
              <% matrix[day].forEach(s => { %>
                <div class="p-3 rounded-4 mb-3 timetable-enlarge-card">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge rounded-pill bg-light text-dark border small" style="font-size: 0.68rem;">
                      <i class="bi bi-clock me-1 text-primary"></i><%= s.start_time %>
                    </span>
                    <span class="badge rounded-pill bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">
                      <%= s.consultation_mode || 'In-Person' %>
                    </span>
                  </div>

                  <div class="fw-bold small text-dark text-truncate mb-1" title="<%= s.faculty_name %>"><%= s.faculty_name %></div>
                  <div class="text-muted small mb-2" style="font-size: 0.72rem;">
                    <i class="bi bi-geo-alt me-1"></i><%= s.office_location || 'CCS Lounge' %>
                  </div>

                  <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="text-muted" style="font-size: 0.68rem;">Cap: <%= s.max_students %></span>
                    <a href="/faculty/<%= s.faculty_id %>/book" class="btn btn-primary-pill btn-sm py-0 px-2" style="font-size: 0.72rem;">
                      Book <i class="bi bi-chevron-right"></i>
                    </a>
                  </div>
                </div>
              <% }); %>
            <% } %>

          </div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>
