<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book Consultation - <%= f.full_name %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
  <style>
    .calendar-grid {
      display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; text-align: center; margin-top: 15px;
    }
    .calendar-day-header { font-size: 0.75rem; font-weight: 700; color: #64748b; padding-bottom: 8px; text-transform: uppercase; }
    .calendar-cell {
      height: 52px; display: flex; align-items: center; justify-content: center;
      border-radius: 14px; font-weight: 600; font-size: 0.95rem; border: 1px solid transparent;
      user-select: none;
    }
    .cell-disabled { color: #cbd5e1; cursor: not-allowed; }
    .cell-today { border: 2px solid #415993 !important; }
    .cell-available {
      background-color: #415993 !important; color: white !important; cursor: pointer; transition: transform 0.15s, box-shadow 0.15s;
    }
    .cell-available:hover { transform: scale(1.05); box-shadow: 0 4px 12px rgba(65, 89, 147, 0.35); }
    .cell-selected {
      outline: 3px solid #1e293b; outline-offset: 2px;
    }

    /* Slot Pill styling */
    .slot-item-soft {
      background: #ffffff; border: 1px solid #dce4ef; border-radius: 16px; padding: 12px 18px;
      margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between;
      cursor: pointer; transition: all 0.2s;
    }
    .slot-item-soft:hover { background-color: #f1f5fa; }
    .slot-item-soft.selected {
      background-color: #415993; color: white !important; border-color: #415993; box-shadow: 0 4px 14px rgba(65, 89, 147, 0.3);
    }
    .slot-item-soft.disabled {
      background: #f1f5fa; color: #94a3b8; cursor: not-allowed;
    }
  </style>
</head>
<body>
  <%- include('../partials/navbar', { active: 'directory' }) %>

  <div class="container my-4" style="max-width: 1280px;">
    <div class="mb-3">
      <a href="/faculty" class="btn btn-icon-circle me-1" title="Back to Directory"><i class="bi bi-arrow-left"></i></a>
      <span class="text-muted small fw-semibold">Back to Faculty Directory</span>
    </div>

    <div class="row g-4">
      <!-- Left Column: Instructor Profile Details -->
      <div class="col-lg-4">
        <div class="soft-card p-4 text-center">
          <% 
            const initials = (f.full_name || 'Prof')
              .replace(/^(Engr\.|Dr\.|Prof\.)\s*/i, '')
              .split(' ')
              .slice(0, 2)
              .map(n => n[0])
              .join('');
          %>
          <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-2 mx-auto mb-3" style="width: 80px; height: 80px; background: #415993;">
            <%= initials %>
          </div>
          <h5 class="fw-bold text-dark mb-1"><%= f.full_name %></h5>
          <div class="text-muted small mb-3">Instructor / Faculty</div>

          <div class="text-start small text-muted border-top pt-3">
            <div class="mb-2"><i class="bi bi-building me-2 text-primary"></i> <%= f.department || 'College of Computer Studies' %></div>
            <div class="mb-2"><i class="bi bi-geo-alt me-2 text-primary"></i> <%= f.office_location || 'CCS Faculty Lounge' %></div>
            <div class="mb-2"><i class="bi bi-envelope me-2 text-primary"></i> <%= f.email %></div>
            <% if (f.meeting_link) { %>
              <div class="mb-2"><i class="bi bi-camera-video me-2 text-primary"></i> <a href="<%= f.meeting_link %>" target="_blank" class="text-decoration-none">Online Meeting Link</a></div>
            <% } %>
          </div>

          <div class="p-3 rounded-4 mt-3" style="background: #f1f5fa; border: 1px solid #dce4ef;">
            <div class="text-muted small text-uppercase fw-bold" style="font-size: 0.7rem;">Next Available Duty</div>
            <div class="fw-bold" style="color: #415993;"><%= f.next_available %></div>
          </div>

          <div class="mt-3 text-start small border-top pt-3">
            <div class="fw-bold text-dark mb-2">Weekly Consultation Days:</div>
            <% if (f.slots && f.slots.length > 0) { %>
              <% f.slots.forEach(s => { %>
                <div class="badge rounded-pill bg-light text-dark border me-1 mb-1 px-3 py-2">
                  <i class="bi bi-clock me-1"></i> <%= s.day_of_week %> (<%= s.start_time %> - <%= s.end_time %>)
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-muted">No scheduled slots configured.</div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Neumorphic Calendar -->
      <div class="col-lg-8">
        <div class="soft-card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0" id="calendarMonthTitle">October 2026</h5>
            <div class="small">
              <span class="badge rounded-pill text-white px-3 py-1" style="background: #415993;">Available consultation days</span>
            </div>
          </div>

          <div class="calendar-grid">
            <div class="calendar-day-header">Sun</div>
            <div class="calendar-day-header">Mon</div>
            <div class="calendar-day-header">Tue</div>
            <div class="calendar-day-header">Wed</div>
            <div class="calendar-day-header">Thu</div>
            <div class="calendar-day-header">Fri</div>
            <div class="calendar-day-header">Sat</div>
            <div id="calendarDaysContainer" style="display: contents;"></div>
          </div>

          <div class="d-flex flex-wrap gap-3 mt-4 pt-3 border-top small text-muted justify-content-center">
            <div class="d-flex align-items-center gap-1">
              <span class="badge p-1 rounded-circle" style="width: 10px; height: 10px; background: #415993;"> </span>
              <span>Available day</span>
            </div>
            <div class="d-flex align-items-center gap-1">
              <span class="badge p-1 bg-secondary rounded-circle" style="width: 10px; height: 10px;"> </span>
              <span>Unavailable day</span>
            </div>
            <div class="d-flex align-items-center gap-1">
              <span class="border border-2 border-primary rounded" style="width: 12px; height: 12px;"> </span>
              <span>Today</span>
            </div>
          </div>
        </div>

        <!-- Slot Selection Section -->
        <div id="slotsSection" class="soft-card p-4 mt-4 d-none">
          <h6 class="fw-bold text-dark mb-3" id="selectedDateHeading">Select a Slot</h6>
          <div id="slotsList"></div>

          <!-- Booking Submission Form -->
          <form id="bookingSubmissionForm" action="/consultations/book" method="POST" class="mt-4 pt-3 border-top d-none">
            <input type="hidden" name="faculty_id" value="<%= f.id %>">
            <input type="hidden" name="consultation_date" id="formConsultationDate">
            <input type="hidden" name="time_slot" id="formTimeSlot">

            <div class="row g-3 mb-3">
              <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted">Subject / Course Code</label>
                <input type="text" name="subject_code" class="form-control sunken-input" placeholder="e.g., CCIT 101, IT 312">
              </div>
              <div class="col-md-7">
                <label class="form-label small fw-semibold text-muted">Consultation Concern / Agenda *</label>
                <input type="text" name="topic_agenda" class="form-control sunken-input" placeholder="Brief description of consultation topic..." required>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <div class="small fw-semibold text-dark">
                Selected: <span id="selectedSlotSummary" class="font-monospace" style="color: #415993;">None</span>
              </div>
              <button type="submit" class="btn btn-primary-pill">
                <i class="bi bi-calendar-check me-1"></i> Book Appointment
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    const facultyDutyDays = <%- JSON.stringify((f.slots || []).map(s => s.day_of_week)) %>;
    const bookedConsultations = <%- bookedConsultations %>;

    const calendarContainer = document.getElementById('calendarDaysContainer');
    const slotsSection = document.getElementById('slotsSection');
    const selectedDateHeading = document.getElementById('selectedDateHeading');
    const slotsList = document.getElementById('slotsList');
    const bookingForm = document.getElementById('bookingSubmissionForm');
    const formDate = document.getElementById('formConsultationDate');
    const formTimeSlot = document.getElementById('formTimeSlot');
    const selectedSlotSummary = document.getElementById('selectedSlotSummary');

    const today = new Date();
    const year = today.getFullYear();
    const month = today.getMonth();
    
    document.getElementById('calendarMonthTitle').textContent = today.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

    const firstDayIndex = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    for (let i = 0; i < firstDayIndex; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.className = 'calendar-cell cell-disabled';
      calendarContainer.appendChild(emptyCell);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const cellDate = new Date(year, month, day);
      const dayOfWeekStr = weekdays[cellDate.getDay()];
      const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

      const cell = document.createElement('div');
      cell.className = 'calendar-cell';
      cell.textContent = day;

      const isToday = (today.getFullYear() === year && today.getMonth() === month && today.getDate() === day);
      if (isToday) cell.classList.add('cell-today');

      const isDutyDay = facultyDutyDays.includes(dayOfWeekStr);
      if (isDutyDay) {
        cell.classList.add('cell-available');
        cell.title = `${dayOfWeekStr} — Available`;
        cell.addEventListener('click', () => selectCalendarDate(cell, dateStr, dayOfWeekStr, day));
      } else {
        cell.classList.add('cell-disabled');
      }

      calendarContainer.appendChild(cell);
    }

    const availableSlotsTemplates = [
      '09:00 AM - 10:30 AM',
      '10:30 AM - 12:00 PM',
      '01:00 PM - 02:30 PM',
      '02:30 PM - 04:00 PM'
    ];

    function selectCalendarDate(cell, dateStr, dayOfWeekStr, day) {
      document.querySelectorAll('.cell-available').forEach(c => c.classList.remove('cell-selected'));
      cell.classList.add('cell-selected');

      slotsSection.classList.remove('d-none');
      selectedDateHeading.textContent = `${dayOfWeekStr}, ${dateStr} — Select a Slot`;
      formDate.value = dateStr;

      const bookingsOnDate = bookedConsultations.filter(c => {
        const cDate = new Date(c.consultation_date).toISOString().split('T')[0];
        return cDate === dateStr && (c.status === 'pending' || c.status === 'confirmed');
      });
      const bookedSlotTimes = bookingsOnDate.map(c => c.time_slot);

      slotsList.innerHTML = '';
      bookingForm.classList.add('d-none');
      formTimeSlot.value = '';

      availableSlotsTemplates.forEach((slotTime, index) => {
        const isBooked = bookedSlotTimes.includes(slotTime);
        const item = document.createElement('div');
        item.className = 'slot-item-soft' + (isBooked ? ' disabled' : '');

        item.innerHTML = `
          <div class="d-flex align-items-center gap-3">
            <span class="badge ${isBooked ? 'bg-secondary' : 'bg-dark'} rounded-circle px-2">${index + 1}</span>
            <span class="fw-semibold">${slotTime}</span>
          </div>
          <span class="badge rounded-pill ${isBooked ? 'bg-danger text-white' : 'bg-success-subtle text-success'} px-3 py-2">
            ${isBooked ? 'Booked' : 'Available'}
          </span>
        `;

        if (!isBooked) {
          item.addEventListener('click', () => {
            document.querySelectorAll('.slot-item-soft').forEach(el => el.classList.remove('selected'));
            item.classList.add('selected');
            formTimeSlot.value = slotTime;
            selectedSlotSummary.textContent = `${slotTime} (${dateStr})`;
            bookingForm.classList.remove('d-none');
          });
        }

        slotsList.appendChild(item);
      });

      slotsSection.scrollIntoView({ behavior: 'smooth' });
    }
  </script>
</body>
</html>
