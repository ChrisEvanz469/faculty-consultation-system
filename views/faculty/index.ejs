<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faculty Directory - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body>
  <%- include('../partials/navbar', { active: 'directory' }) %>

  <div class="container my-4" style="max-width: 1280px;">
    <!-- Hero Banner -->
    <div class="hero-banner-soft">
      <div class="small text-uppercase fw-semibold tracking-wide text-light opacity-75 mb-1"><%= greeting %>,</div>
      <h2 class="fw-bold mb-1 text-uppercase"><%= user.full_name %></h2>
      <div class="small opacity-90"><i class="bi bi-calendar3 me-1"></i> <%= todayFormatted %></div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
      <div>
        <h4 class="fw-bold text-dark mb-1">Faculty Directory</h4>
        <p class="text-muted small mb-0">Browse faculty members, verify consultation availability, and schedule appointments.</p>
      </div>
      <div>
        <span class="badge rounded-pill px-3 py-2 text-white" style="background: #415993;">
          <i class="bi bi-people-fill me-1"></i> Total Instructors: <%= facultyList.length %>
        </span>
      </div>
    </div>

    <!-- Inset Sunken Search Bar -->
    <div class="soft-card p-3 mb-4">
      <div class="row g-2 align-items-center">
        <div class="col-md-9">
          <div class="input-group">
            <span class="input-group-text border-0 bg-transparent text-muted ps-3"><i class="bi bi-search"></i></span>
            <input type="text" id="liveSearchInput" class="form-control sunken-input" placeholder="Search name, specialization, or office room...">
          </div>
        </div>
        <div class="col-md-3 text-md-end text-muted small pe-3">
          <span id="matchCount"><%= facultyList.length %> instructors shown</span>
        </div>
      </div>
    </div>

    <!-- Faculty Cards Grid -->
    <div class="row g-4" id="facultyCardsContainer">
      <% facultyList.forEach(function(f) { %>
        <% 
          const initials = (f.full_name || 'Prof')
            .replace(/^(Engr\.|Dr\.|Prof\.)\s*/i, '')
            .split(' ')
            .slice(0, 2)
            .map(n => n[0])
            .join('');
        %>
        <div class="col-md-6 col-lg-4 faculty-item" 
             data-name="<%= (f.full_name || '').toLowerCase() %>" 
             data-dept="<%= (f.department || '').toLowerCase() %>"
             data-office="<%= (f.office_location || '').toLowerCase() %>">
          <div class="soft-card h-100 p-4 d-flex flex-column">
            
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 text-white" style="width: 52px; height: 52px; background: #415993;">
                <%= initials %>
              </div>
              <div>
                <h6 class="fw-bold text-dark mb-0"><%= f.full_name %></h6>
                <div class="text-muted small">Instructor / Faculty</div>
              </div>
            </div>

            <div class="small text-muted mb-3 flex-grow-1">
              <div class="mb-1"><i class="bi bi-building me-1"></i> <%= f.department || 'College of Computer Studies' %></div>
              <div class="mb-1"><i class="bi bi-geo-alt me-1"></i> <%= f.office_location || 'CCS Faculty Lounge' %></div>
              <div><i class="bi bi-envelope me-1"></i> <%= f.email %></div>
            </div>

            <!-- Next Available Opening Box -->
            <div class="p-3 rounded-4 mb-3 d-flex justify-content-between align-items-center" style="background: #f1f5fa; border: 1px solid #dce4ef;">
              <div>
                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem;">Next Available:</div>
                <div class="fw-bold small" style="color: #415993;"><%= f.next_available %></div>
              </div>
              <a href="/faculty/<%= f.id %>/book" class="btn btn-icon-circle" style="background: #415993; color: white;" title="Book Appointment">
                <i class="bi bi-chevron-right"></i>
              </a>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
              <% if (f.review_count > 0) { %>
                <span class="small text-dark">
                  <i class="bi bi-star-fill text-warning me-1"></i><strong><%= f.avg_rating %></strong>/5.0
                  <span class="text-muted">(<%= f.review_count %>)</span>
                </span>
              <% } else { %>
                <span class="small text-muted"><i class="bi bi-star me-1"></i>No ratings yet</span>
              <% } %>

              <a href="/faculty/<%= f.id %>/book" class="btn btn-primary-pill btn-sm">
                View Calendar
              </a>
            </div>

          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('liveSearchInput');
    const cards = document.querySelectorAll('.faculty-item');
    const matchCount = document.getElementById('matchCount');

    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      let visible = 0;

      cards.forEach(card => {
        const matches = card.dataset.name.includes(query) || 
                        card.dataset.dept.includes(query) || 
                        card.dataset.office.includes(query);
        if (matches) {
          card.classList.remove('d-none');
          visible++;
        } else {
          card.classList.add('d-none');
        }
      });
      matchCount.textContent = visible + ' instructors shown';
    });
  </script>
</body>
</html>
