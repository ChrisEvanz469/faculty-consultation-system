<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faculty Directory - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; }
    .faculty-card { transition: transform 0.2s, box-shadow 0.2s; border-radius: 12px; }
    .faculty-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.08); }
    .mode-badge { font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; }
    .role-badge { font-size: 0.68rem; letter-spacing: 0.8px; font-weight: 800; padding: 4px 8px; border-radius: 6px; }
  </style>
</head>
<body>
  <!-- Standardized Locked Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/dashboard">
        <i class="bi bi-calendar2-check-fill me-2 fs-5"></i> Faculty Consultation Portal
      </a>
      <div class="d-flex align-items-center gap-2">
        <a href="/dashboard" class="btn btn-outline-light btn-sm"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
        <a href="/faculty" class="btn btn-light btn-sm text-primary fw-semibold"><i class="bi bi-search me-1"></i> Directory</a>
        <a href="/consultations" class="btn btn-outline-light btn-sm"><i class="bi bi-journal-text me-1"></i> Appointments</a>
        
        <div class="vr bg-white mx-2" style="height: 22px; opacity: 0.35;"></div>
        
        <!-- User Badge Capsule -->
        <div class="d-flex align-items-center bg-white bg-opacity-10 border border-white border-opacity-25 rounded-pill px-3 py-1 me-1">
          <i class="bi bi-person-circle text-white me-2 fs-6"></i>
          <span class="text-white fw-semibold small me-2"><%= user.full_name %></span>
          <span class="badge <%= user.role === 'faculty' ? 'bg-warning text-dark' : 'bg-white text-primary' %> text-uppercase role-badge">
            <%= user.role %>
          </span>
        </div>

        <a href="/logout" class="btn btn-outline-light btn-sm" title="Logout"><i class="bi bi-box-arrow-right"></i></a>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
      <div>
        <h3 class="fw-bold text-dark mb-1">Faculty Consultation Directory</h3>
        <p class="text-muted small mb-0">Search instructors, verify office consultation hours, and schedule appointments.</p>
      </div>
      <div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
          <i class="bi bi-people-fill me-1"></i> Total Faculty: <%= facultyList.length %>
        </span>
      </div>
    </div>

    <!-- Live Search Filter Bar -->
    <div class="card border-0 shadow-sm p-3 mb-4 rounded-3">
      <div class="row g-2 align-items-center">
        <div class="col-md-8">
          <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="liveSearchInput" class="form-control border-start-0 ps-0" placeholder="Type faculty name, department, or office room...">
          </div>
        </div>
        <div class="col-md-4 text-md-end text-muted small">
          <span id="matchCount"><%= facultyList.length %> instructors shown</span>
        </div>
      </div>
    </div>

    <!-- Faculty Cards Grid -->
    <div class="row g-3" id="facultyCardsContainer">
      <% if (facultyList.length === 0) { %>
        <div class="col-12 text-center py-5 text-muted">
          <i class="bi bi-inbox fs-1 d-block mb-2"></i>
          No faculty members registered in directory.
        </div>
      <% } %>

      <% facultyList.forEach(function(f) { %>
        <div class="col-md-6 col-lg-4 faculty-item" 
             data-name="<%= (f.full_name || '').toLowerCase() %>" 
             data-dept="<%= (f.department || '').toLowerCase() %>"
             data-office="<%= (f.office_location || '').toLowerCase() %>">
          <div class="card h-100 faculty-card border-0 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="badge bg-secondary-subtle text-secondary mode-badge px-2 py-1">
                <i class="bi bi-geo-alt-fill me-1"></i><%= f.consultation_mode || 'In-Person' %>
              </span>
              <span class="badge bg-info-subtle text-info border border-info-subtle small"><%= f.id_number %></span>
            </div>
            
            <h5 class="fw-bold text-dark mb-1"><%= f.full_name %></h5>
            <p class="text-primary small fw-semibold mb-1"><%= f.department || 'College of Computer Studies' %></p>
            
            <div class="mb-3">
              <% if (f.review_count > 0) { %>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-1 px-2">
                  <i class="bi bi-star-fill text-warning me-1"></i><strong><%= f.avg_rating %></strong> / 5.0
                  <span class="text-muted fw-normal ms-1">(<%= f.review_count %> <%= f.review_count === 1 ? 'review' : 'reviews' %>)</span>
                </span>
              <% } else { %>
                <span class="badge bg-light text-muted border py-1 px-2">
                  <i class="bi bi-star me-1 text-secondary"></i>No ratings yet
                </span>
              <% } %>
            </div>

            <div class="small text-muted mb-3">
              <div class="mb-1"><i class="bi bi-building me-1"></i> <strong>Office:</strong> <%= f.office_location || 'CCS Faculty Room' %></div>
              <div><i class="bi bi-envelope me-1"></i> <strong>Email:</strong> <%= f.email %></div>
              <% if (f.meeting_link) { %>
                <div class="mt-1"><i class="bi bi-camera-video me-1"></i> <a href="<%= f.meeting_link %>" target="_blank" class="text-decoration-none">Online Link Available</a></div>
              <% } %>
            </div>

            <div class="mt-auto pt-2 border-top">
              <button class="btn btn-primary w-100 btn-sm fw-semibold" 
                      data-bs-toggle="modal" 
                      data-bs-target="#bookingModal" 
                      data-id="<%= f.id %>" 
                      data-name="<%= f.full_name %>"
                      data-dept="<%= f.department %>"
                      data-mode="<%= f.consultation_mode || 'In-Person' %>">
                <i class="bi bi-calendar-plus me-1"></i> Book Consultation
              </button>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <div id="noMatchState" class="text-center py-5 d-none text-muted">
      <i class="bi bi-search fs-1 d-block mb-2 text-secondary"></i>
      <h5>No matching faculty found</h5>
      <p class="small">Try searching with another instructor name or keyword.</p>
    </div>
  </div>

  <!-- Booking Modal -->
  <div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title fw-bold"><i class="bi bi-calendar2-plus me-1"></i> Schedule Consultation</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form action="/consultations/book" method="POST">
          <div class="modal-body p-4">
            <input type="hidden" name="faculty_id" id="modalFacultyId">
            
            <div class="alert alert-light border mb-3 py-2 small">
              <div class="fw-bold text-dark" id="modalFacultyName">Instructor Name</div>
              <div class="text-muted" id="modalFacultyDept">Department</div>
              <div class="badge bg-secondary-subtle text-secondary mt-1" id="modalFacultyMode">Mode</div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Preferred Date <span class="text-danger">*</span></label>
              <input type="date" name="consultation_date" class="form-control" required>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Time Slot <span class="text-danger">*</span></label>
              <select name="time_slot" class="form-select" required>
                <option value="">-- Select Time Slot --</option>
                <option value="09:00 AM - 10:30 AM">09:00 AM - 10:30 AM (Morning)</option>
                <option value="10:30 AM - 12:00 PM">10:30 AM - 12:00 PM (Morning)</option>
                <option value="01:00 PM - 02:30 PM">01:00 PM - 02:30 PM (Afternoon)</option>
                <option value="02:30 PM - 04:00 PM">02:30 PM - 04:00 PM (Afternoon)</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Course / Subject Code</label>
              <input type="text" name="subject_code" class="form-control" placeholder="e.g., IT 312, CC 106">
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold">Consultation Agenda / Concern <span class="text-danger">*</span></label>
              <textarea name="topic_agenda" class="form-control" rows="3" placeholder="Describe the topics or academic concerns to consult..." required></textarea>
            </div>
          </div>
          <div class="modal-footer bg-light border-0">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm fw-semibold">Confirm Booking Request</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('liveSearchInput');
    const cards = document.querySelectorAll('.faculty-item');
    const matchCount = document.getElementById('matchCount');
    const noMatch = document.getElementById('noMatchState');

    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      let visible = 0;

      cards.forEach(card => {
        const name = card.dataset.name;
        const dept = card.dataset.dept;
        const office = card.dataset.office;
        const matches = name.includes(query) || dept.includes(query) || office.includes(query);

        if (matches) {
          card.classList.remove('d-none');
          visible++;
        } else {
          card.classList.add('d-none');
        }
      });

      matchCount.textContent = visible + ' instructors shown';
      noMatch.classList.toggle('d-none', visible > 0);
    });

    const bookingModal = document.getElementById('bookingModal');
    if (bookingModal) {
      bookingModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('modalFacultyId').value = btn.getAttribute('data-id');
        document.getElementById('modalFacultyName').textContent = btn.getAttribute('data-name');
        document.getElementById('modalFacultyDept').textContent = btn.getAttribute('data-dept');
        document.getElementById('modalFacultyMode').textContent = 'Mode: ' + btn.getAttribute('data-mode');
      });
    }
  </script>
</body>
</html>
