<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background-color: #f1f5f9; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: system-ui, -apple-system, sans-serif; padding: 25px 15px; }
    .card-register { max-width: 540px; width: 100%; border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,0.06); }
  </style>
</head>
<body>
  <div class="card card-register bg-white border-0 p-4">
    <div class="text-center mb-4">
      <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 52px; height: 52px;">
        <i class="bi bi-person-plus-fill fs-3"></i>
      </div>
      <h4 class="fw-bold mb-1 text-dark">Create Account</h4>
      <p class="text-muted small">Register for CSPC Faculty Consultation Portal</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i> <%= error %>
      </div>
    <% } %>

    <form action="/register" method="POST">
      <!-- Role Selection Toggle -->
      <div class="mb-3">
        <label class="form-label small fw-semibold">Account Role <span class="text-danger">*</span></label>
        <div class="row g-2">
          <div class="col-6">
            <input type="radio" class="btn-check" name="role" id="roleStudent" value="student" <%= (!formData.role || formData.role === 'student') ? 'checked' : '' %>>
            <label class="btn btn-outline-primary w-100 py-2 fw-semibold small" for="roleStudent">
              <i class="bi bi-mortarboard me-1"></i> Student
            </label>
          </div>
          <div class="col-6">
            <input type="radio" class="btn-check" name="role" id="roleFaculty" value="faculty" <%= (formData.role === 'faculty') ? 'checked' : '' %>>
            <label class="btn btn-outline-primary w-100 py-2 fw-semibold small" for="roleFaculty">
              <i class="bi bi-person-video3 me-1"></i> Faculty
            </label>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label small fw-semibold" id="idLabel">Student ID Number <span class="text-danger">*</span></label>
          <input type="text" name="id_number" id="idInput" class="form-control" placeholder="e.g. 2411971" value="<%= formData.id_number || '' %>" required>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
          <input type="text" name="full_name" class="form-control" placeholder="e.g. Cris Ivan Nual" value="<%= formData.full_name || '' %>" required>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold">College / Program Department <span class="text-danger">*</span></label>
          <input type="text" name="department" class="form-control" placeholder="e.g. BS Information Technology" value="<%= formData.department || 'College of Computer Studies' %>" required>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold">Institutional Email <span class="text-danger">*</span></label>
          <input type="email" name="email" class="form-control" placeholder="e.g. user@cspc.edu.ph" value="<%= formData.email || '' %>" required>
        </div>

        <div class="col-12">
          <label class="form-label small fw-semibold">Choose Username <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-at"></i></span>
            <input type="text" name="username" class="form-control" placeholder="e.g. ivan_nual" value="<%= formData.username || '' %>" required>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold">Password <span class="text-danger">*</span></label>
          <input type="password" name="password" class="form-control" placeholder="At least 6 characters" required>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold">Confirm Password <span class="text-danger">*</span></label>
          <input type="password" name="confirm_password" class="form-control" placeholder="Re-type password" required>
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mt-4">
        <i class="bi bi-check2-circle me-1"></i> Register Account
      </button>
    </form>

    <div class="mt-4 pt-3 border-top text-center">
      <span class="text-muted small">Already have an account?</span>
      <a href="/login" class="fw-semibold text-primary text-decoration-none small ms-1">
        Sign In
      </a>
    </div>
  </div>

  <script>
    const roleStudent = document.getElementById('roleStudent');
    const roleFaculty = document.getElementById('roleFaculty');
    const idLabel = document.getElementById('idLabel');
    const idInput = document.getElementById('idInput');

    function updateLabels() {
      if (roleFaculty.checked) {
        idLabel.innerHTML = 'Faculty Employee ID <span class="text-danger">*</span>';
        idInput.placeholder = 'e.g. PROF-2026-05';
      } else {
        idLabel.innerHTML = 'Student ID Number <span class="text-danger">*</span>';
        idInput.placeholder = 'e.g. 2411971';
      }
    }

    roleStudent.addEventListener('change', updateLabels);
    roleFaculty.addEventListener('change', updateLabels);
    updateLabels();
  </script>
</body>
</html>
