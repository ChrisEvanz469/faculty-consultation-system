<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create Account - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body class="d-flex align-items-center justify-content-center p-3" style="min-height: 100vh; background-color: #f4f0fa;">
  <div class="card border-0 p-5" style="max-width: 580px; width: 100%; background: #ffffff; border-radius: 28px; box-shadow: 10px 10px 24px #d7cfe6, -10px -10px 24px #ffffff;">
    <div class="text-center mb-4">
      <div class="btn-icon-circle mx-auto mb-3" style="width: 58px; height: 58px; font-size: 1.5rem; color: #6d28d9; pointer-events: none;">
        <i class="bi bi-person-plus-fill"></i>
      </div>
      <h4 class="fw-bold text-dark mb-1">Create Account</h4>
      <p class="text-muted small">Register for CSPC Faculty Consultation Portal</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small rounded-3" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i> <%= error %>
      </div>
    <% } %>

    <form action="/register" method="POST">
      <div class="mb-3">
        <label class="form-label small fw-semibold text-muted">Account Role <span class="text-danger">*</span></label>
        <div class="row g-2">
          <div class="col-6">
            <input type="radio" class="btn-check" name="role" id="roleStudent" value="student" <%= (!formData.role || formData.role === 'student') ? 'checked' : '' %>>
            <label class="btn btn-outline-secondary w-100 py-2 fw-semibold small" style="border-radius: 20px;" for="roleStudent">
              <i class="bi bi-mortarboard me-1"></i> Student
            </label>
          </div>
          <div class="col-6">
            <input type="radio" class="btn-check" name="role" id="roleFaculty" value="faculty" <%= (formData.role === 'faculty') ? 'checked' : '' %>>
            <label class="btn btn-outline-secondary w-100 py-2 fw-semibold small" style="border-radius: 20px;" for="roleFaculty">
              <i class="bi bi-person-video3 me-1"></i> Faculty
            </label>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted" id="idLabel">Student ID Number <span class="text-danger">*</span></label>
          <div class="neumorph-input-group">
            <i class="bi bi-card-heading input-icon"></i>
            <input type="text" name="id_number" id="idInput" placeholder="e.g. 2411971" value="<%= formData.id_number || '' %>" required>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Full Name <span class="text-danger">*</span></label>
          <div class="neumorph-input-group">
            <i class="bi bi-person input-icon"></i>
            <input type="text" name="full_name" placeholder="e.g. Cris Ivan Nual" value="<%= formData.full_name || '' %>" required>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Program / Department <span class="text-danger">*</span></label>
          <div class="neumorph-input-group">
            <i class="bi bi-building input-icon"></i>
            <input type="text" name="department" placeholder="e.g. BS Information Technology" value="<%= formData.department || 'College of Computer Studies' %>" required>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Institutional Email <span class="text-danger">*</span></label>
          <div class="neumorph-input-group">
            <i class="bi bi-envelope input-icon"></i>
            <input type="email" name="email" placeholder="e.g. user@cspc.edu.ph" value="<%= formData.email || '' %>" required>
          </div>
        </div>

        <div class="col-12">
          <label class="form-label small fw-semibold text-muted">Choose Username <span class="text-danger">*</span></label>
          <div class="neumorph-input-group">
            <i class="bi bi-at input-icon"></i>
            <input type="text" name="username" placeholder="e.g. ivan_nual" value="<%= formData.username || '' %>" required>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Password <span class="text-danger">*</span></label>
          <div class="neumorph-input-group">
            <i class="bi bi-lock input-icon"></i>
            <input type="password" name="password" placeholder="At least 6 characters" required>
          </div>
        </div>

        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Confirm Password <span class="text-danger">*</span></label>
          <div class="neumorph-input-group">
            <i class="bi bi-check2-circle input-icon"></i>
            <input type="password" name="confirm_password" placeholder="Re-type password" required>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-pill w-100 py-2 mt-4">
        <i class="bi bi-check2-circle me-1"></i> Register Account
      </button>
    </form>

    <div class="mt-4 pt-3 border-top text-center text-muted small">
      Already have an account? 
      <a href="/login" class="fw-semibold text-decoration-none" style="color: #6d28d9;">Sign In</a>
    </div>
  </div>

  <script>
    const roleStudent = document.getElementById('roleStudent');
    const roleFaculty = document.getElementById('roleFaculty');
    const idLabel = document.getElementById('idLabel');
    const idInput = document.getElementById('idInput');

    function updateRoleLabels() {
      if (roleFaculty.checked) {
        idLabel.innerHTML = 'Faculty Employee ID <span class="text-danger">*</span>';
        idInput.placeholder = 'e.g. PROF-2026-05';
      } else {
        idLabel.innerHTML = 'Student ID Number <span class="text-danger">*</span>';
        idInput.placeholder = 'e.g. 2411971';
      }
    }
    roleStudent.addEventListener('change', updateRoleLabels);
    roleFaculty.addEventListener('change', updateRoleLabels);
    updateRoleLabels();
  </script>
</body>
</html>
