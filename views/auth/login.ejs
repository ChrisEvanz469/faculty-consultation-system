<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Faculty Consultation Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/custom.css" rel="stylesheet">
</head>
<body class="d-flex align-items-center justify-content-center p-3">
  <div class="soft-card p-5" style="max-width: 440px; width: 100%;">
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 58px; height: 58px; background: #e9eef5; color: #415993;">
        <i class="bi bi-calendar2-check-fill fs-3"></i>
      </div>
      <h4 class="fw-bold text-dark mb-1">Faculty Consultation</h4>
      <p class="text-muted small">Academic Portal Sign In</p>
    </div>

    <% if (registered) { %>
      <div class="alert alert-success py-2 small rounded-3" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> Account registered successfully! You may now sign in.
      </div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-danger py-2 small rounded-3" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i> <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3">
        <label class="form-label small fw-semibold text-muted">Username</label>
        <div class="input-group">
          <span class="input-group-text border-0 bg-transparent text-muted ps-3"><i class="bi bi-person"></i></span>
          <input type="text" name="username" class="form-control sunken-input" placeholder="Enter username" required autofocus>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label small fw-semibold text-muted">Password</label>
        <div class="input-group">
          <span class="input-group-text border-0 bg-transparent text-muted ps-3"><i class="bi bi-lock"></i></span>
          <input type="password" name="password" class="form-control sunken-input" placeholder="Enter password" required>
        </div>
      </div>

      <button type="submit" class="btn btn-primary-pill w-100 py-2">
        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
      </button>
    </form>

    <div class="mt-4 pt-3 border-top text-center text-muted small">
      Don't have an account yet? 
      <a href="/register" class="fw-semibold text-decoration-none" style="color: #415993;">Create an Account</a>
    </div>
  </div>
</body>
</html>
